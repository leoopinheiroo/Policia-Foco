# --- SUPABASE CONFIGURATION ---
# Get these in Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the 'service_role' (secret) key, NOT the 'anon' key
SUPABASE_SERVICE_ROLE_KEY=
# Optional: 'anon' key for public access if needed
SUPABASE_ANON_KEY=

# --- STRIPE CONFIGURATION ---
# Get these in Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these in Stripe Dashboard > Product Catalog
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# --- AI CONFIGURATION ---
# Get this in Google AI Studio
GEMINI_API_KEY=

# --- APP CONFIGURATION ---
# The URL of your application (e.g. https://ais-dev-....run.app)
APP_URL=
